# ==========================================
# DocuAI RAG System - Environment Configuration
# ==========================================

# 1. LLM Generation (Groq API - Free tier friendly)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Database Configuration
# Default is zero-config local SQLite (rag.db).
# For PostgreSQL (e.g., Neon, Supabase, RDS), uncomment and fill below:
DATABASE_URL=sqlite:///./rag.db
# DATABASE_URL=postgresql://user:password@localhost:5432/docuai_db

# 3. Authentication & Security
# Change this secret key in production!
JWT_SECRET=docuai-super-secret-key-change-in-production

# 4. Local Server Port (optional)
PORT=8000
